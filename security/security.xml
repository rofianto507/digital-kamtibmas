<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module category -->
        <record id="module_category_dkm" model="ir.module.category">
            <field name="name">Digital Kamtibmas</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilege (grup di dropdown user) — Odoo 19: res.groups.privilege -->
        <record id="privilege_dkm_access" model="res.groups.privilege">
            <field name="name">Digital Kamtibmas</field>
            <field name="category_id" ref="module_category_dkm"/>
            <field name="sequence">10</field>
        </record>

        <!-- Admin: akses penuh -->
        <record id="group_dkm_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
        </record>

        <!-- Operator: CRUD tanpa delete -->
        <record id="group_dkm_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
        </record>

        <!-- Masyarakat: hanya akses Discuss (konsultasi online) -->
        <record id="group_masyarakat" model="res.groups">
            <field name="name">Masyarakat</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
            <!-- Harus internal user agar bisa buka /odoo/discuss -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Patroli: akses khusus fitur patroli lapangan (app mobile patroli) -->
        <record id="group_dkm_patroli" model="res.groups">
            <field name="name">Patroli</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>

    <!-- Menu overrides + Record rules — noupdate="0" agar diperbarui saat upgrade -->
    <data>

        <!--
            Sembunyikan Calendar, Contacts, HR, Spreadsheet dari masyarakat & patroli.
            (6, 0, [...]) mengganti seluruh group_ids — Admin/Operator/System tetap bisa akses.
        -->
        <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <record id="hr.menu_hr_root" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <!-- Discuss: sembunyikan sub-menu Channels dan Configuration dari masyarakat & patroli -->
        <record id="mail.menu_channel" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <record id="mail.menu_configuration" model="ir.ui.menu">
            <field name="group_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('digital_kamtibmas.group_dkm_admin'),
                    ref('digital_kamtibmas.group_dkm_operator'),
                ])
            ]"/>
        </record>

        <!-- Record rule: group_dkm_patroli hanya lihat patroli milik grupnya sendiri -->
        <record id="rule_patroli_own_grup" model="ir.rule">
            <field name="name">Patroli: user patroli hanya lihat record grupnya</field>
            <field name="model_id" ref="model_digital_kamtibmas_patroli"/>
            <field name="domain_force">[('grup_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_dkm_patroli'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- User biasa: hanya lihat/edit record milik sendiri -->
        <record id="rule_eform_laka_own_user" model="ir.rule">
            <field name="name">e-Form Laka: user hanya melihat record sendiri</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            Discuss Channel: masyarakat hanya lihat channel yang dia ikuti.
            Tanpa rule ini, semua internal user bisa lihat semua channel.
        -->
        <record id="rule_discuss_channel_masyarakat" model="ir.rule">
            <field name="name">Discuss Channel: masyarakat hanya lihat channel sendiri</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="domain_force">
                [
                    ('channel_member_ids.partner_id', '=', user.partner_id.id),
                    ('channel_type', '!=', 'chat')
                ]
            </field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_masyarakat'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin: lihat semua record (override rule user) -->
        <record id="rule_eform_laka_all_admin" model="ir.rule">
            <field name="name">e-Form Laka: admin melihat semua record</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_dkm_admin'))]"/>
        </record>

        <!-- Operator: lihat semua record (override rule user) -->
        <record id="rule_eform_laka_all_operator" model="ir.rule">
            <field name="name">e-Form Laka: operator melihat semua record</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_dkm_operator'))]"/>
        </record>

    </data>
</odoo>
