<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module category -->
        <record id="module_category_dkm" model="ir.module.category">
            <field name="name">Digital Kamtibmas</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilege (grup di dropdown user) — Odoo 19: res.groups.privilege -->
        <record id="privilege_dkm_access" model="res.groups.privilege">
            <field name="name">Digital Kamtibmas</field>
            <field name="category_id" ref="module_category_dkm"/>
            <field name="sequence">10</field>
        </record>

        <!-- Admin: akses penuh -->
        <record id="group_dkm_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
        </record>

        <!-- Operator: CRUD tanpa delete -->
        <record id="group_dkm_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="privilege_id" ref="privilege_dkm_access"/>
        </record>

    </data>

    <!-- Record rules — noupdate="0" agar diperbarui saat upgrade modul -->
    <data>

        <!-- User biasa: hanya lihat/edit record milik sendiri -->
        <record id="rule_eform_laka_own_user" model="ir.rule">
            <field name="name">e-Form Laka: user hanya melihat record sendiri</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin: lihat semua record (override rule user) -->
        <record id="rule_eform_laka_all_admin" model="ir.rule">
            <field name="name">e-Form Laka: admin melihat semua record</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_dkm_admin'))]"/>
        </record>

        <!-- Operator: lihat semua record (override rule user) -->
        <record id="rule_eform_laka_all_operator" model="ir.rule">
            <field name="name">e-Form Laka: operator melihat semua record</field>
            <field name="model_id" ref="model_digital_kamtibmas_eform_laka"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('digital_kamtibmas.group_dkm_operator'))]"/>
        </record>

    </data>
</odoo>
