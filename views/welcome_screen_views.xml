<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_welcome_screen_form" model="ir.ui.view">
        <field name="name">digital.kamtibmas.welcome.screen.form</field>
        <field name="model">digital.kamtibmas.welcome.screen</field>
        <field name="arch" type="xml">
            <form string="Welcome Screen">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                        </group>
                        <group>
                            <field name="image" widget="image"
                                   options="{'size': [400, 600]}"
                                   filename="image_filename"/>
                            <field name="image_filename" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="keterangan" placeholder="Keterangan tambahan (opsional)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_welcome_screen_list" model="ir.ui.view">
        <field name="name">digital.kamtibmas.welcome.screen.list</field>
        <field name="model">digital.kamtibmas.welcome.screen</field>
        <field name="arch" type="xml">
            <list string="Welcome Screen">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="keterangan"/>
            </list>
        </field>
    </record>

    <record id="action_welcome_screen" model="ir.actions.act_window">
        <field name="name">Welcome Screen</field>
        <field name="res_model">digital.kamtibmas.welcome.screen</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
