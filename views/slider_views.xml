<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_slider_form" model="ir.ui.view">
        <field name="name">digital.kamtibmas.slider.form</field>
        <field name="model">digital.kamtibmas.slider</field>
        <field name="arch" type="xml">
            <form string="Slider Mobile">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="image" widget="image"
                                   options="{'size': [500, 300]}"
                                   filename="image_filename"/>
                            <field name="image_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_slider_list" model="ir.ui.view">
        <field name="name">digital.kamtibmas.slider.list</field>
        <field name="model">digital.kamtibmas.slider</field>
        <field name="arch" type="xml">
            <list string="Slider Mobile">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [80, 50]}"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_slider" model="ir.actions.act_window">
        <field name="name">Slider Mobile</field>
        <field name="res_model">digital.kamtibmas.slider</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
