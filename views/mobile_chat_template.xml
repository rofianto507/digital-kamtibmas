<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mobile_chat_template" name="Konseling — Mobile Chat">
        <html lang="id">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <meta name="theme-color" content="#0D1526"/>
                <title><t t-esc="channel_name"/></title>
                <style>
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    html, body { height: 100%; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #F0F4FF; }

                    #chat-root { display: flex; flex-direction: column; height: 100dvh; max-width: 480px; margin: 0 auto; }

                    /* Header */
                    #chat-header {
                        background: #0D1526;
                        color: #fff;
                        padding: 12px 16px 10px;
                        flex-shrink: 0;
                        border-bottom: 1px solid rgba(255,255,255,0.06);
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }
                    #back-btn {
                        background: none; border: none; cursor: pointer;
                        color: rgba(255,255,255,0.8);
                        display: flex; align-items: center; justify-content: center;
                        padding: 4px; border-radius: 6px; flex-shrink: 0;
                        transition: color .15s;
                    }
                    #back-btn:hover { color: #fff; }
                    #back-btn svg { fill: currentColor; }
                    #header-info { flex: 1; min-width: 0; }
                    #videocall-btn {
                        background: rgba(255,255,255,0.12);
                        border: none; border-radius: 8px;
                        width: 36px; height: 36px;
                        cursor: pointer; flex-shrink: 0;
                        display: flex; align-items: center; justify-content: center;
                        color: #fff;
                        transition: background .15s;
                    }
                    #videocall-btn:hover { background: rgba(255,255,255,0.22); }
                    #videocall-btn svg { fill: currentColor; }

                    #chat-header h1 { font-size: 15px; font-weight: 700; letter-spacing: 0.1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    #chat-header p  { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 2px; }

                    /* Load more */
                    .load-more-spinner {
                        align-self: center;
                        width: 20px; height: 20px;
                        border: 2px solid rgba(106,27,154,0.2);
                        border-top-color: #6A1B9A;
                        border-radius: 50%;
                        animation: spin .8s linear infinite;
                        margin: 8px 0;
                    }
                    .load-more-end {
                        align-self: center;
                        font-size: 11px;
                        color: #9CA3AF;
                        padding: 6px 12px;
                        background: #E9EEF8;
                        border-radius: 20px;
                        margin: 8px 0;
                    }

                    /* Typing indicator */
                    #typing-indicator {
                        display: none;
                        align-items: center;
                        gap: 8px;
                        padding: 4px 16px 2px;
                        background: #fff;
                        font-size: 12px;
                        color: #6B7280;
                        flex-shrink: 0;
                    }
                    .typing-dots { display: flex; gap: 3px; align-items: center; }
                    .typing-dots span {
                        width: 5px; height: 5px;
                        background: #9CA3AF; border-radius: 50%;
                        animation: tdot 1.2s infinite;
                    }
                    .typing-dots span:nth-child(2) { animation-delay: .2s; }
                    .typing-dots span:nth-child(3) { animation-delay: .4s; }
                    @keyframes tdot {
                        0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
                        40% { transform: translateY(-4px); opacity: 1; }
                    }

                    /* Messages */
                    #msg-list {
                        flex: 1;
                        overflow-y: auto;
                        padding: 16px 12px 8px;
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                        scroll-behavior: smooth;
                    }
                    #msg-list::-webkit-scrollbar { width: 3px; }
                    #msg-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.12); border-radius: 2px; }

                    .msg { display: flex; flex-direction: column; max-width: 80%; }
                    .msg.mine  { align-self: flex-end;   align-items: flex-end; }
                    .msg.other { align-self: flex-start; align-items: flex-start; }

                    .msg-name {
                        font-size: 11px; font-weight: 600;
                        color: #6B7280; margin-bottom: 3px; padding: 0 4px;
                    }
                    .msg-bubble {
                        padding: 9px 13px;
                        border-radius: 16px;
                        font-size: 14px;
                        line-height: 1.5;
                        word-break: break-word;
                    }
                    .msg.mine  .msg-bubble { background: #6A1B9A; color: #fff; border-bottom-right-radius: 4px; }
                    .msg.other .msg-bubble { background: #fff; color: #1D2A44; border-bottom-left-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }

                    .msg-bubble p { margin: 0; }
                    .msg-bubble p + p { margin-top: 4px; }
                    .msg-bubble a { color: inherit; text-decoration: underline; }

                    .msg-time { font-size: 10px; color: #9CA3AF; margin-top: 3px; padding: 0 4px; }
                    .err { color: #ef4444; font-size: 13px; text-align: center; }

                    /* Empty / Loading states */
                    #msg-empty, #msg-loading {
                        flex: 1;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        color: #9CA3AF;
                        font-size: 13px;
                        gap: 10px;
                    }
                    #msg-empty svg, #msg-loading svg { opacity: 0.3; }

                    .spinner {
                        width: 28px; height: 28px;
                        border: 3px solid rgba(106,27,154,0.2);
                        border-top-color: #6A1B9A;
                        border-radius: 50%;
                        animation: spin .8s linear infinite;
                    }
                    @keyframes spin { to { transform: rotate(360deg); } }

                    /* Input area */
                    #chat-input-area {
                        display: flex;
                        flex-direction: column;
                        padding: 8px 12px 10px;
                        background: #fff;
                        border-top: 1px solid #E5E7EB;
                        flex-shrink: 0;
                    }
                    #input-row {
                        display: flex;
                        align-items: flex-end;
                        gap: 6px;
                    }
                    #msg-input {
                        flex: 1;
                        border: 1.5px solid #E5E7EB;
                        border-radius: 20px;
                        padding: 9px 14px;
                        font-size: 14px;
                        font-family: inherit;
                        outline: none;
                        resize: none;
                        max-height: 90px;
                        line-height: 1.45;
                        color: #1D2A44;
                        transition: border-color .2s;
                        overflow-y: auto;
                    }
                    #msg-input:focus { border-color: #6A1B9A; }
                    #msg-input::placeholder { color: #9CA3AF; }

                    #attach-btn {
                        width: 36px; height: 36px;
                        background: none;
                        border: none;
                        border-radius: 50%;
                        cursor: pointer;
                        display: flex; align-items: center; justify-content: center;
                        flex-shrink: 0;
                        color: #9CA3AF;
                        transition: color .15s, background .15s;
                    }
                    #attach-btn:hover { color: #6A1B9A; background: rgba(106,27,154,0.08); }
                    #attach-btn svg { fill: currentColor; }

                    #send-btn {
                        width: 40px; height: 40px;
                        background: #6A1B9A;
                        border: none; border-radius: 50%;
                        cursor: pointer;
                        display: flex; align-items: center; justify-content: center;
                        flex-shrink: 0;
                        transition: opacity .15s, transform .1s;
                    }
                    #send-btn:active { transform: scale(0.93); }
                    #send-btn:disabled { opacity: 0.4; cursor: default; }
                    #send-btn svg { fill: #fff; }

                    /* File preview (muncul di atas input row) */
                    #attach-preview {
                        display: none;
                        align-items: center;
                        gap: 10px;
                        padding: 8px 4px 8px;
                        margin-bottom: 6px;
                        border-bottom: 1px solid #F3F4F6;
                    }
                    #attach-thumb {
                        width: 48px; height: 48px;
                        object-fit: cover;
                        border-radius: 8px;
                        border: 1px solid #E5E7EB;
                        flex-shrink: 0;
                        background: #F3F4F6;
                    }
                    #attach-name {
                        flex: 1;
                        font-size: 12px;
                        color: #374151;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                    }
                    #attach-remove {
                        background: #F3F4F6;
                        border: none;
                        border-radius: 50%;
                        width: 24px; height: 24px;
                        cursor: pointer;
                        font-size: 16px;
                        line-height: 1;
                        color: #6B7280;
                        display: flex; align-items: center; justify-content: center;
                        flex-shrink: 0;
                    }

                    /* Scroll-to-bottom button */
                    #scroll-btn {
                        position: absolute;
                        bottom: 16px;
                        right: 16px;
                        width: 36px;
                        height: 36px;
                        border-radius: 50%;
                        background: #fff;
                        border: none;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
                        cursor: pointer;
                        display: none;
                        align-items: center;
                        justify-content: center;
                        transition: opacity .2s, transform .2s;
                        z-index: 10;
                    }
                    #scroll-btn.visible { display: flex; }
                    #scroll-btn:active { transform: scale(0.9); }
                    #scroll-btn svg { fill: #6A1B9A; }

                    #msg-area {
                        flex: 1;
                        position: relative;
                        overflow: hidden;
                        display: flex;
                        flex-direction: column;
                    }

                    /* Date separator */
                    .date-sep {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        margin: 6px 0;
                        color: #9CA3AF;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                    }
                    .date-sep::before,
                    .date-sep::after {
                        content: '';
                        flex: 1;
                        height: 1px;
                        background: #E5E7EB;
                    }
                    .date-sep span {
                        white-space: nowrap;
                        padding: 2px 8px;
                        background: #E9EEF8;
                        border-radius: 20px;
                    }

                    /* Attachments */
                    .msg-attachment { margin-top: 4px; }
                    .msg-img {
                        display: block;
                        max-width: 220px;
                        max-height: 220px;
                        border-radius: 12px;
                        cursor: pointer;
                        object-fit: cover;
                        transition: opacity .15s;
                    }
                    .msg-img:active { opacity: 0.75; }
                    .msg.mine  .msg-img { border-bottom-right-radius: 4px; }
                    .msg.other .msg-img { border-bottom-left-radius: 4px; }

                    .msg-file {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        padding: 7px 12px;
                        border-radius: 10px;
                        font-size: 13px;
                        font-weight: 500;
                        text-decoration: none;
                        background: rgba(0,0,0,0.07);
                        color: inherit;
                    }
                    .msg.mine .msg-file { background: rgba(255,255,255,0.18); color: #fff; }
                </style>
            </head>
            <body>
                <div id="chat-root">
                    <!-- Header -->
                    <div id="chat-header">
                        <button id="back-btn" aria-label="Kembali" onclick="history.back()">
                            <svg width="22" height="22" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                        </button>
                        <div id="header-info">
                            <h1><t t-esc="channel_name"/></h1>
                            <p>Sesi Konsultasi</p>
                        </div>
                        <button id="videocall-btn" aria-label="Mulai video call">
                            <svg width="22" height="22" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
                        </button>
                    </div>

                    <!-- Scrollable area wrapper (untuk positioning tombol) -->
                    <div id="msg-area">
                        <!-- Loading -->
                        <div id="msg-loading">
                            <div class="spinner"/>
                            <span>Memuat pesan...</span>
                        </div>

                        <!-- Message list (hidden until loaded) -->
                        <div id="msg-list" style="display:none;"/>

                        <!-- Empty state (hidden until needed) -->
                        <div id="msg-empty" style="display:none;">
                            <svg width="48" height="48" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                            <span>Belum ada pesan. Mulai percakapan!</span>
                        </div>

                        <!-- Scroll to bottom -->
                        <button id="scroll-btn" aria-label="Gulir ke bawah">
                            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
                        </button>
                    </div>

                    <!-- Typing indicator -->
                    <div id="typing-indicator">
                        <div class="typing-dots">
                            <span/><span/><span/>
                        </div>
                        <span id="typing-text"/>
                    </div>

                    <!-- Input area -->
                    <div id="chat-input-area">
                        <!-- Preview file yang dipilih -->
                        <div id="attach-preview">
                            <img id="attach-thumb" alt=""/>
                            <span id="attach-name"/>
                            <button id="attach-remove" aria-label="Hapus lampiran">&#xD7;</button>
                        </div>
                        <!-- Row input -->
                        <div id="input-row">
                            <input type="file" id="file-input" accept="image/*,application/pdf,.doc,.docx" style="display:none"/>
                            <button id="attach-btn" aria-label="Lampirkan file">
                                <svg width="20" height="20" viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                            </button>
                            <textarea id="msg-input" rows="1" placeholder="Tulis pesan..."/>
                            <button id="send-btn" aria-label="Kirim">
                                <svg width="18" height="18" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- QWeb variables (integer/JSON outputs — no XML-unsafe characters) -->
                <script>
                    const CHANNEL_ID    = <t t-out="channel_id"/>;
                    const MY_PARTNER_ID = <t t-out="current_partner_id"/>;
                    const CHANNEL_NAME  = <t t-out="channel_name_json"/>;
                </script>

                <!-- Chat logic loaded from static file -->
                <script src="/digital_kamtibmas/static/src/js/mobile_chat.js"/>
            </body>
        </html>
    </template>
</odoo>
