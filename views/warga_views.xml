<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- List view -->
  <record id="view_warga_list" model="ir.ui.view">
    <field name="name">digital_kamtibmas.warga.list</field>
    <field name="model">digital_kamtibmas.warga</field>
    <field name="arch" type="xml">
      <list string="Warga" create="0" edit="0" delete="0"
            decoration-danger="deletion_pending"
            decoration-muted="not active">
        <field name="create_date"/>
        <field name="name"/>
        <field name="login"/>
        <field name="phone" optional="show"/>
        <field name="antrian_count" optional="show"/>
        <field name="eform_count" optional="show"/>
        <field name="konseling_count" optional="show"/>
        <field name="rehab_count" optional="show"/>
        <field name="deletion_pending" optional="show"/>
        <field name="active" widget="boolean" optional="show"/>
      </list>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_warga_form" model="ir.ui.view">
    <field name="name">digital_kamtibmas.warga.form</field>
    <field name="model">digital_kamtibmas.warga</field>
    <field name="arch" type="xml">
      <form string="Warga" create="0" edit="0" delete="0">
        <header>
          <button name="action_reset_password" type="object" string="Reset Password"
                  class="btn-primary"
                  confirm="Buat password baru untuk akun ini? Password lama tidak berlaku lagi."
                  invisible="not active"/>
          <button name="action_toggle_active" type="object" string="Nonaktifkan"
                  invisible="not active"
                  confirm="Nonaktifkan akun ini? Warga tidak bisa login sampai diaktifkan kembali."/>
          <button name="action_toggle_active" type="object" string="Aktifkan"
                  class="btn-primary" invisible="active"/>
          <button name="action_hapus_akun" type="object" string="Hapus Akun"
                  class="btn-danger"
                  confirm="Hapus akun ini? Nama, kontak, dan foto dihapus permanen, akun dinonaktifkan. Riwayat layanan tetap tersimpan tanpa identitas. Tindakan ini tidak bisa dibatalkan."
                  invisible="not active"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object" name="action_open_antrian" icon="fa-ticket">
              <field name="antrian_count" widget="statinfo" string="Antrian"/>
            </button>
            <button class="oe_stat_button" type="object" name="action_open_eform" icon="fa-car">
              <field name="eform_count" widget="statinfo" string="e-Form Laka"/>
            </button>
            <button class="oe_stat_button" type="object" name="action_open_konseling" icon="fa-comments">
              <field name="konseling_count" widget="statinfo" string="Konseling"/>
            </button>
            <button class="oe_stat_button" type="object" name="action_open_rehab" icon="fa-heartbeat">
              <field name="rehab_count" widget="statinfo" string="Rehabilitasi"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger" invisible="active"/>
          <field name="image_128" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <div class="alert alert-danger" role="alert" invisible="not deletion_pending">
            Warga ini meminta penghapusan akun. Gunakan tombol <b>Hapus Akun</b> untuk memproses.
          </div>
          <group>
            <group string="Akun">
              <field name="login"/>
              <field name="create_date"/>
              <field name="active"/>
              <field name="deletion_pending" invisible="1"/>
            </group>
            <group string="Kontak">
              <field name="phone"/>
              <field name="street"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search -->
  <record id="view_warga_search" model="ir.ui.view">
    <field name="name">digital_kamtibmas.warga.search</field>
    <field name="model">digital_kamtibmas.warga</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" filter_domain="['|', ('name', 'ilike', self), ('login', 'ilike', self)]"
               string="Nama / Username"/>
        <field name="phone"/>
        <filter name="aktif" string="Aktif" domain="[('active', '=', True)]"/>
        <filter name="nonaktif" string="Nonaktif" domain="[('active', '=', False)]"/>
        <filter name="by_month" string="Bulan Daftar" context="{'group_by': 'create_date:month'}"/>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_warga" model="ir.actions.act_window">
    <field name="name">Warga</field>
    <field name="res_model">digital_kamtibmas.warga</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_aktif': 1}</field>
  </record>

  <!-- Menu ada di menu.xml (dimuat terakhir) -->

</odoo>
