<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Paper format: A4 Landscape, no margins ════════════════════════════ -->
    <record id="paperformat_a4_landscape_cert" model="report.paperformat">
        <field name="name">A4 Landscape Sertifikat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- ══ Report action ══════════════════════════════════════════════════════ -->
    <record id="action_report_sertifikat" model="ir.actions.report">
        <field name="name">Cetak Sertifikat</field>
        <field name="model">digital_kamtibmas.sertifikasi.peserta</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">digital_kamtibmas.sertifikasi_cetak_template</field>
        <field name="report_file">digital_kamtibmas.sertifikasi_cetak_template</field>
        <field name="print_report_name">'Sertifikat - ' + object.nama</field>
        <field name="binding_model_id" ref="model_digital_kamtibmas_sertifikasi_peserta"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_landscape_cert"/>
    </record>

    <template id="sertifikasi_cetak_template">
        <t t-call="web.html_container">
            <t t-set="data_report_landscape" t-value="True"/>

            <t t-foreach="docs" t-as="p">
                <!--
                    Fix #1 — Bootstrap container max-width:
                      web.html_container membungkus konten dalam <div class="container">
                      Bootstrap membatasi lebar ~970px → ruang kosong di kanan.
                      Solusi: override semua container + gunakan width:100% (bukan 297mm).
                    Fix #2 — wkhtmltopdf nbsp encoding:
                      &#160; di XML dikodekan UTF-8 (0xC2 0xA0) tapi wkhtmltopdf
                      lama membacanya sebagai Latin-1 sehingga muncul "Â".
                      Solusi: gunakan CSS separator (.cp-sep) bukan karakter nbsp.
                    Fix #3 — height:
                      Gunakan 260mm (sama seperti template sebelumnya yang bekerja).
                      wkhtmltopdf menambah sedikit ruang dari html_container wrapper.
                -->
                <div style="height:0;overflow:hidden;margin:0;padding:0;"><style>
                    /* ── Reset + Bootstrap override ─────────────────────────── */
                    * { box-sizing: border-box; margin: 0; padding: 0; }

                    html, body {
                        margin: 0 !important;
                        padding: 0 !important;
                        width: 100% !important;
                        height: 260mm;
                        overflow: hidden;
                        font-size: 0;
                    }

                    /* Hapus max-width Bootstrap + Odoo agar lebar penuh */
                    body > div, .container, .container-fluid,
                    .o_report_layout, .o_report_layout_standard,
                    .article, #wkhtmltopdf_page_break {
                        max-width: none !important;
                        width: 100% !important;
                        padding: 0 !important;
                        margin: 0 !important;
                    }

                    /* ── Page container ─────────────────────────────────────── */
                    .cp {
                        width: 100%;
                        height: 260mm;
                        position: relative;
                        overflow: hidden;
                        font-family: Arial, Helvetica, sans-serif;
                        -webkit-print-color-adjust: exact;
                        print-color-adjust: exact;
                    }

                    /* ── Full-page background image ─────────────────────────── */
                    .cp-bg {
                        position: absolute;
                        top: 0; left: 0;
                        width: 100%; height: 100%;
                        display: block;
                    }

                    /* ── Content block: centered dynamic text ───────────────── */
                    .cp-content {
                        position: absolute;
                        top: 135mm;
                        left: 0; right: 0;
                        text-align: center;
                    }

                    .cp-given {
                        font-size: 9pt;
                        color: #777;
                        font-style: italic;
                        letter-spacing: 3px;
                        margin-bottom: 4px;
                    }

                    /* Gold gradient rules flanking name */
                    .cp-nrule-t {
                        width: 55%; height: 1px;
                        background: #C9A227;
                        background: -webkit-linear-gradient(left, transparent, #C9A227, transparent);
                        background: linear-gradient(to right, transparent, #C9A227, transparent);
                        margin: 0 auto 5px;
                    }
                    .cp-nrule-b {
                        width: 60%; height: 2px;
                        background: #C9A227;
                        background: -webkit-linear-gradient(left, transparent, #C9A227 20%, #C9A227 80%, transparent);
                        background: linear-gradient(to right, transparent, #C9A227 20%, #C9A227 80%, transparent);
                        margin: 4px auto 8px;
                    }

                    /* Recipient name */
                    .cp-name {
                        font-family: 'Segoe Script', 'Lucida Handwriting',
                                     'Brush Script MT', Georgia, serif;
                        font-size: 30pt;
                        font-weight: bold;
                        font-style: italic;
                        color: #1D2A44;
                        line-height: 1.15;
                    }

                    .cp-detail {
                        font-size: 9.5pt;
                        color: #444;
                        margin-bottom: 5px;
                    }

                    /* CSS dot separator — pengganti &#160; yang bermasalah di wkhtmltopdf */
                    .cp-sep {
                        display: inline-block;
                        width: 4px; height: 4px;
                        background: #C9A227;
                        border-radius: 50%;
                        vertical-align: middle;
                        margin: 0 10px 2px;
                    }

                    .cp-pill {
                        display: inline-block;
                        background: #C9A227;
                        color: #fff;
                        font-weight: 700;
                        padding: 1px 9px;
                        border-radius: 8px;
                        font-size: 8.5pt;
                    }

                    .cp-desc {
                        font-size: 10pt;
                        color: #333;
                        margin-bottom: 4px;
                    }

                    .cp-lulus {
                        font-weight: 700;
                        color: #1D2A44;
                        background: rgba(201,162,39,0.18);
                        padding: 0 4px;
                    }

                    .cp-sertname {
                        font-size: 12.5pt;
                        font-weight: 700;
                        color: #1D2A44;
                    }

                    /* ── Footer: cert number (bottom-left) ─────────────────── */
                    /* .cp tinggi 260mm tapi kertas A4 landscape hanya 210mm.
                       Pakai top positioning agar tetap visible dalam 210mm. */
                    .cp-certno-blk {
                        position: absolute;
                        top: 202mm;
                        left: 65mm;
                        font-size: 7pt;
                        color: #aaa;
                        font-family: 'Courier New', monospace;
                    }

                    /* ── Footer: date + signature (bottom-right) ────────────── */
                    .cp-sig-blk {
                        position: absolute;
                        top: 180mm;
                        right: 70mm;
                        text-align: center;
                        width: 150px;
                    }
                    .cp-date     { font-size: 8.5pt; color: #555; margin-bottom: 30px; }
                    .cp-sig-line { width: 130px; height: 1px; background: #1D2A44; margin: 0 auto 4px; }
                    .cp-sig-org  { font-size: 8pt; font-weight: 700; color: #1D2A44; letter-spacing: 1px; }
                    .cp-sig-sub  { font-size: 7pt; color: #777; }
                </style></div>

                <div class="cp">
                    <!-- 1. Background: template.jpeg (ornate border + header + logo sudah ada) -->
                    <img class="cp-bg" t-attf-src="data:image/jpeg;base64,#{template_b64}" alt=""/>

                    <!-- 2. Dynamic content overlay -->
                    <div class="cp-content">
                        <div class="cp-given">Diberikan kepada :</div>
                        <div class="cp-nrule-t"/>
                        <div class="cp-name"><t t-esc="p.nama"/></div>
                        <div class="cp-nrule-b"/>
                        <div class="cp-detail">
                            NIK : <t t-esc="p.nik"/>
                            <span class="cp-sep"/>
                            Nilai : <span class="cp-pill"><t t-esc="'%.1f' % p.nilai"/></span>
                        </div>
                        <div class="cp-desc">
                            Telah menyelesaikan dan dinyatakan
                            <span class="cp-lulus">LULUS</span>
                            ujian sertifikasi :
                        </div>
                        <div class="cp-sertname"><t t-esc="p.sertifikasi_id.name"/></div>
                    </div>

                    <!-- 3. Cert number: bottom-left -->
                    <div class="cp-certno-blk">
                        No.: CERT-<t t-esc="p.waktu_selesai.year if p.waktu_selesai else '2026'"/>-<t t-esc="'%05d' % p.id"/>
                    </div>

                    <!-- 4. Date + signature: bottom-right -->
                    <div class="cp-sig-blk">
                        <div class="cp-date">
                            Palembang, <t t-esc="format_date_id(p.waktu_selesai)"/>
                        </div>
                        <div class="cp-sig-line"/>
                        <div class="cp-sig-org">AMPERA247</div>
                        <div class="cp-sig-sub">Layanan Digital Kamtibmas</div>
                        <div class="cp-sig-sub">Kota Palembang</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
